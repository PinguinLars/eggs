{
    "label" : "lock",
    "action" : "swaylock",
    "text" : "[L]ock",
    "keybind" : "l"
}
{
    "label" : "logout",
    "action" : "niri msg action quit -s",
    "text" : "[E]xit",
    "keybind" : "e"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "[S]hutdown",
    "keybind" : "s"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "S[u]spend",
    "keybind" : "u"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "[R]eboot",
    "keybind" : "r"
}
{
    "label" : "soft-reboot",
    "action" : "systemctl soft-reboot",
    "text" : "Sof[t] Reboot",
    "keybind" : "t"
}
