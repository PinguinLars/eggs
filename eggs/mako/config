sort=-time
layer=overlay
#{#rcol(data.colors.noti_background)#}
background-color=#121318
width=300
height=110
border-size=4
#{#rcol(data.colors.normal)#}
border-color=#b1c5ff
border-radius=15
icons=1
max-icon-size=64
default-timeout=5000
ignore-timeout=1
font=JetBrainsMono Nerd Font 14
max-history=20

[urgency=low]
#{#rcol(data.colors.low)#}
