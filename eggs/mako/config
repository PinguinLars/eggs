[urgency=normal]
#{#rcol(data.colors.normal)#}
border-color=#b1c5ff

[urgency=high]
#{#rcol(data.colors.high)#}
border-color=#e0bbdd
default-timeout=0

[category=mpd]
default-timeout=2000
group-by=category

[mode=dnd]
invisible=1
