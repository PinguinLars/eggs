sort=-time
layer=overlay
#{#rcol(data.colors.noti_background)#}
background-color=#1a1111
width=300
height=110
border-size=4
#{#rcol(data.colors.normal)#}
border-color=#ffb3b1
border-radius=15
icons=1
max-icon-size=64
default-timeout=5000
ignore-timeout=1
font=JetBrainsMono Nerd Font 14
max-history=20

[urgency=low]
#{#rcol(data.colors.low)#}
border-color=#e6bdbb

[urgency=normal]
#{#rcol(data.colors.normal)#}
border-color=#ffb3b1

[urgency=high]
#{#rcol(data.colors.high)#}
border-color=#e3c28d
default-timeout=0

[category=mpd]
default-timeout=2000
group-by=category

[mode=dnd]
invisible=1
