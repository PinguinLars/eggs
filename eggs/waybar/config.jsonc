{
  "layer": "top",
  "modules-left": [
    "niri/workspaces",
    "custom/power",
    "power-profiles-daemon",
    "tray",
  ],
  "modules-center": [
    "pulseaudio",
    "clock",
    "backlight",
  ],
  "modules-right": [
    "systemd-failed-units",
    "battery",
    "temperature",
    "cpu",
    "memory",
    "disk",
  ],
  "niri/workspaces": {},
  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "~/.config/waybar/power_menu.xml",
    "menu-actions": {
      "shutdown": "shutdown",
      "reboot": "reboot",
      "suspend": "systemctl suspend",
      "logout": "niri msg action quit",
      "lock": "swaylock -f",
    },
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "performance": "",
      "balanced": "",
      "power-saver": "",
    },
  },
  "tray": {
    "show-passive-items": true,
    "icon-size": 23
  }
}
