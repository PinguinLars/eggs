;; -*- mode: lisp -*-

(include "./clock.yuck")
(include "./workspaces.yuck")
(include "./system.yuck")
(include "./desktop.yuck")

(
 defwindow bar
 :monitor 0
 :geometry
 (
  geometry
  :x "0%"
  :y "0.0%"
  :width "100.0%"
  :height "5%"
  :anchor "top center"
  )
 :stacking "fg"
 :exclusive true
 :focusable false
 (
  centerbox
  :orientation "h"
   :class "bar"
  (
   box
   :space-evenly false
   :spacing 10
   :halign "start"
   (workspaces)
   )
  (
   box
   :spacing 10
   :halign "center"
   :space-evenly false
   ; (
   ;  box
   ;  :width 100
   ;  (
   ;   scale
   ;   :class "test"
   ;   :min 0
   ;   :max 100
   ;   :hexpand true
   ;   )
   ;  )
   )
  (
   box
   :spacing 10
   :halign "end"
   :space-evenly false
   (system)
   (clock)
   )
  )
 )
