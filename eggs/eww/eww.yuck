;; -*- mode: lisp -*-

;; lisp comments are amazing btw (and fortran also)

(include "power.yuck")
(include "tuned.yuck")
(include "workspaces.yuck")
(include "dnd.yuck")
(include "sound.yuck")
(include "brightness.yuck")
(include "temps.yuck")
(include "disk.yuck")
(include "cpu.yuck")
(include "ram.yuck")
(include "battery.yuck")

(defpoll time :interval "1s" `date +%H:%M`)
(defpoll date :interval "1s" `date "+%D %H:%M:%S"`)

(
 defwindow bar [padding] ;; is 12
 :monitor 0
 :geometry
 (
  geometry
  :x "0%"
  :y "${padding}px"
  :width "${1366-padding*2}px" ;; is my monitor width
  :height "40px"
  :anchor "top center"
  )
 :stacking "fg"
 :exclusive true
 :focusable false
 (
  centerbox
  :orientation "h"
  :class "bar"
  (
   box
   :space-evenly false
   :spacing 5
   :halign "start"
   :class "bar-part"
   (workspaces) 
   (power)
   (tuned)
   (dnd)
   (systray :class "bar-element bar-element-right systray")
   )
  (
   box
   :space-evenly false
   :spacing 5
   :halign "center"
   :class "bar-part"
   (sound)
   (
    box
    :class "bar-element clock"
    :tooltip date
    "${time}"
    )
   (brightness)
   )
  (
   box
   :space-evenly false
   :spacing 5
   :halign "end"
   :class "bar-part"
   (battery)
   (temps)
   (cpu)
   (ram)
   (disk)
   )
  )
 )

(
 defwindow test
 :monitor 0 
 :geometry
 (
  geometry
  ; :width "90%"
  :height "30px"
  :anchor "left center"
  )
 :stacking "fg"
 :reserve (struts :distance "40px" :side "top")
 :windowtype "dock"
 (
  box
  :class "dock"
  "hi"
  )
 )
