;; -*- mode: lisp -*-

(
 defwindow desktop
 :monitor 0
 :geometry (
            geometry
            :x "12px"
            :y "12px"
            :anchor "bottom left"
            )
 :stacking "bg"
 :exclusive "false"
 :focusable "none"
 :namespace "desktop-widgets"
 (
  box
  :class "desktop-widgets"
  :spacing 12
  :orientation "v"
  (power-buttons)
  (desktop-apps)
  )
 )

(
 defwidget power-buttons[]
 (
  box
  :spacing 12
  (
   box
   :orientation "v"
   :spacing 12
   (
    box
    :class "desktop-widget"
    "1"
    )
   (
    box
    :class "desktop-widget"
    "2"
    )
   )
  (
   box
   :orientation "v"
   :spacing 12
   (
    box
    :class "desktop-widget"
    "3"
    )
   (
    box
    :class "desktop-widget"
    "4"
    )
   )
  )
 )

(
 defwidget desktop-apps[]
 (
  box
  :class "desktop-widget desktop-apps"
  :spacing 5
  (
   box
   :orientation "v"
   :spacing 5
   (
    desktop-app
    :path "/home/lars/.icons/candy-icons/apps/scalable/firefox.svg"
    :exe "/usr/bin/firefox & disown"
    )
   (
    desktop-app
    :path "/home/lars/.icons/candy-icons/apps/scalable/spotify-client.svg"
    :exe "flatpak run com.spotify.Client & disown"
    )
   (
    desktop-app
    :path "/home/lars/.icons/candy-icons/apps/scalable/osu.svg"
    :exe "/home/lars/bin/osu & disown"
    )
   )
  (
   box
   :orientation "v"
   :spacing 5
   (
    desktop-app
    :path "/home/lars/.icons/candy-icons/apps/scalable/thunderbird.svg"
    :exe "flatpak run net.thunderbird.Thunderbird & disown"
    )
   (
    desktop-app
    :path "/home/lars/.icons/candy-icons/apps/scalable/onlyoffice.svg"
    :exe "flatpak run org.onlyoffice.desktopeditors & disown"
    )
   (
    desktop-app
    :path "/home/lars/.icons/candy-icons/apps/scalable/minecraft-launcher.svg"
    :exe 'flatpak run com.modrinth.ModrinthApp & disown'
    )
   )
  (
   box
   :orientation "v"
   :spacing 5
   (
    desktop-app
    :path "/home/lars/.icons/candy-icons/apps/scalable/intellij.svg"
    :exe "/home/lars/.local/share/JetBrains/Toolbox/apps/intellij-idea-ultimate/bin/idea & disown"
    )
   (
    desktop-app
    :path "/home/lars/.icons/candy-icons/apps/scalable/rustrover.svg"
    :exe "/home/lars/.local/share/JetBrains/Toolbox/apps/rustrover/bin/rustrover & disown"
    )
   (
    desktop-app
    :path "/home/lars/.icons/candy-icons/apps/scalable/jetbrains-toolbox.svg"
    :exe "/home/lars/.local/share/JetBrains/Toolbox/bin/jetbrains-toolbox & disown"
    )
   )
  )
 )

(
 defwidget desktop-app[path exe]
 (
  eventbox
  :class "desktop-app"
  :onclick exe
  :cursor "pointer"
  (
   image
   :image-width 50
   :image-height 50
   :path path
   )
  )
 )
