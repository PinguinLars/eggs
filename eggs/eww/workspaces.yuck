;; -*- mode: lisp -*-

(deflisten active_workspace :initial "1" `~/.config/eww/scripts/active_workspace.sh`)
(deflisten workspaces :initial "[]" `~/.config/eww/scripts/get_workspaces.sh`)

(
 defwidget workspaces []
 (
  eventbox
  :onclick "echo ${active_workspace}"
  :class "widget"
  :onscroll "~/.config/eww/scripts/switch_workspace.sh {} ${active_workspace}"
  (
   box :space-evenly false
   (
    for workspace in workspaces
    (
     eventbox
     :onclick "niri msg action focus-workspace ${workspace}"
     {workspace == active_workspace ? " " : " " }
     )
    )
   )
  )
 )
